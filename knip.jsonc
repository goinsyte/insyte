{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  /*
   * One `ignore` entry, for a directory that exists: the vendored Effect source (git subtree), read by
   * agents and reviewers and imported by nothing.
   *
   * Upstream also carries entries for agent skill directories installed by their own tools. None of
   * them exist here, because impeccable is used from the user-level install rather than vendored, and
   * knip reports an ignore matching nothing as a configuration hint — which is how those stale
   * entries were found. Add one only when a directory it names actually appears.
   */
  "ignore": ["repos/**"],
  "ignoreDependencies": [
    // The Workers built-in modules (`cloudflare:workers`, `cloudflare:test`), not an npm package.
    "cloudflare",
    // Referenced by .secretlintrc.json, which knip does not parse.
    "@secretlint/secretlint-rule-preset-recommend",
  ],
  "workspaces": {
    // The Claude Code hook is run by .claude/settings.json, which knip does not read.
    ".": {
      "entry": [".claude/hooks/*.ts"],
    },
    "packages/domain": {
      "entry": ["test/**/*.ts"],
    },
    // Tests are entry points, not dead code. `build.ts` is found through the package's own scripts.
    "packages/tokens": {
      "entry": ["test/**/*.ts"],
    },
    "apps/design": {
      // `index.html` finds `src/main.tsx`, which reaches each section through `import.meta.glob` —
      // a call knip does not follow — so the section entries are named. Routes are discovered by
      // @tanstack/router-plugin and imported only by the two generated route trees.
      "entry": [
        "src/*/main.tsx",
        "src/brand/tokens.tsx",
        "src/app/routes/**/*.tsx",
        "src/brand/routes/**/*.tsx",
      ],
      // The fixtures are a port's data, moved whole: a mock-data module keeps exports nothing reads
      // (`todaysFocus`, `settingsNav`), as it did in `apps/console/src/lib`, which was ignored too.
      "ignore": ["src/app/fixtures/**"],
    },
    "packages/integrations/better-auth": {
      // Never imported: there so a declaration can name the two-factor plugin's types, which reach into zod.
      "ignoreDependencies": ["zod"],
    },
    "packages/ui": {
      /*
       * The console's screens and parts (`src/app/`), excluded from the export-level report for the
       * reason `apps/console` excluded them: a port keeps the original's surface — a component file
       * exports helpers only one screen reads — and deleting an export to satisfy knip would be
       * editing a port. (The brand book's chapters need no entry: every export they have is read.)
       */
      // Graduated files (08 §3) are reported like any other.
      "ignore": [
        "src/app/**",
        "!src/app/auth/login-screen.tsx",
        "!src/app/onboarding/shared-steps.tsx",
        "!src/app/onboarding/admin-steps.tsx",
        "!src/app/lib/form-errors.ts",
        "!src/app/orders/**",
        "!src/app/products/**",
        "!src/app/customers/**",
        "!src/app/suppliers/**",
        "!src/app/returns/**",
        "!src/app/quality/**",
        "!src/app/lib/returns.ts",
        "!src/app/lib/quality.ts",
        "!src/app/dashboard/**",
        "!src/app/stores/home-store.ts",
        "!src/app/settings/notifications-screen.tsx",
        "!src/app/settings/notifications-source.tsx",
        "!src/app/settings/notifications-demo-source.tsx",
        "!src/app/settings/workspace-source.tsx",
        "!src/app/settings/workspace-demo-source.tsx",
        "!src/app/settings/form.tsx",
        "!src/app/settings/profile-screen.tsx",
        "!src/app/settings/regional-screen.tsx",
        "!src/app/settings/security-screen.tsx",
        "!src/app/settings/security-source.tsx",
        "!src/app/settings/security-demo-source.tsx",
        "!src/app/lib/home/day.ts",
        "!src/app/lib/home/kinds.ts",
        "!src/app/chats/**",
        "!src/app/inbox/**",
        "!src/app/automations/**",
        "!src/app/costs/**",
      ],
    },
    "apps/console": {
      // The Worker's entry is `main` in wrangler.jsonc; routes are discovered by TanStack Start's plugin and imported
      // only by the generated route tree. `public/sw.js` is registered by the page at run time (`navigator.serviceWorker`).
      "entry": ["src/routes/**/*.tsx", "public/sw.js"],
    },
    "infra": {
      // Read by the alchemy CLI, which knip does not follow.
      "entry": ["app.ts", "shared.ts", "previews.ts"],
    },
    "apps/marketing": {
      // The Worker's entry is `main` in wrangler.jsonc, which knip finds on its own. Routes are
      // discovered by TanStack Start's plugin and imported only by the generated route tree.
      "entry": ["src/routes/**/*.tsx"],
    },
  },
}
