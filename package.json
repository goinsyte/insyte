{
  "name": "@insyte/root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/integrations/*",
      "apps/*",
      "infra"
    ],
    "catalog": {
      "qrcode-generator": "1.4.4",
      "@dnd-kit/core": "6.3.1",
      "@dnd-kit/sortable": "10.0.0",
      "@dnd-kit/utilities": "3.2.2",
      "@cloudflare/vite-plugin": "^1.65.0",
      "@cloudflare/workers-types": "5.20261026.1",
      "@fontsource-variable/archivo": "^5.3.0",
      "@fontsource-variable/inter": "^5.3.0",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-form": "1.29.0",
      "@tanstack/react-router": "^1.170.46",
      "@tanstack/react-start": "1.169.4",
      "@tanstack/router-plugin": "1.168.48",
      "@tanstack/react-table": "8.21.3",
      "@types/node": "25.1.0",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3",
      "@vitejs/plugin-react": "^6.1.1",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "cmdk": "1.1.1",
      "motion": "12.40.0",
      "next-themes": "0.4.6",
      "@base-ui-components/react": "1.0.0-rc.0",
      "react": "19.2.5",
      "react-dom": "19.2.5",
      "react-grid-layout": "2.3.0",
      "recharts": "3.8.0",
      "sonner": "2.0.7",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.3",
      "tw-animate-css": "^1.4.0",
      "vite": "^8.3.1",
      "vitest": "5.0.2",
      "wrangler": "4.153.0",
      "zod": "4.6.5",
      "zustand": "5.0.13",
      "effect": "4.1.2",
      "@cloudflare/vitest-plugin": "1.6.0",
      "@effect/sql-pg": "4.1.2",
      "@effect/atom-react": "4.1.2",
      "@sentry/react": "11.11.0",
      "@sentry/vite-plugin": "11.11.0",
      "better-auth": "1.7.18",
      "kysely": "0.29.8",
      "@effect/platform-bun": "4.1.2",
      "@effect/platform-node": "4.1.2",
      "alchemy": "2.0.0-beta.85",
      "@alchemy.run/cloudflare": "2.0.0-beta.85",
      "@alchemy.run/neon": "2.0.0-beta.85"
    }
  },
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint && (git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true)",
    "check": "tsc -b tsconfig.json && tsc -p packages/domain/tsconfig.test.json && tsc -p packages/database/tsconfig.test.json && tsc -p packages/tokens/tsconfig.test.json && tsc -p packages/ui/tsconfig.test.json && tsc -p packages/integrations/better-auth/tsconfig.test.json && tsc -p packages/integrations/turnstile/tsconfig.test.json && tsc -p apps/design/tsconfig.json && tsc -p apps/design/tsconfig.brand.json && tsc -p apps/marketing/tsconfig.json && tsc -p apps/api/tsconfig.json && tsc -p apps/console/tsconfig.json && tsc -p apps/console/tsconfig.strict.json && tsc -p tsconfig.tools.json && tsc -p infra/tsconfig.json",
    "check:watch": "tsc -b tsconfig.json --watch",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "fix": "bun run format && bun run lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:console": "playwright test -c playwright.console.config.ts",
    "coverage": "vitest run --coverage",
    "knip": "knip",
    "secrets": "secretlint --secretlintignore .secretlintignore '**/*'",
    "deps:check": "syncpack lint",
    "deps:update": "syncpack update",
    "scope": "bun scripts/scope.ts --base main",
    "hygiene": "bun run knip && bun run deps:check && bun run secrets && bun run effect:verify && bun run migrations:check && bun run boundaries && bun run bindings:check && bun run licences && bun run auth:check",
    "effect:verify": "bun scripts/effect-verify.ts",
    "preflight": "bun run format && bun run check && bun run lint && bun run hygiene && bun run test",
    "preflight:ci": "bun run format:check && bun run check && bun run lint && bun run hygiene && bun run test",
    "dev": "bun run design",
    "design": "bun run --filter @insyte/design dev",
    "design:build": "bun run --filter @insyte/design build",
    "design:deploy:dry": "bun run --filter @insyte/design deploy:dry",
    "marketing": "bun run --filter @insyte/marketing dev",
    "api": "bun run --filter @insyte/api-worker dev",
    "console": "bun run --filter @insyte/console dev",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "beta:allow": "bun scripts/beta-allow.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "migrations:check": "bun scripts/migrations-check.ts",
    "api:smoke": "bun scripts/smoke-api.ts",
    "console:smoke": "bun scripts/smoke-console.ts",
    "boundaries": "bun scripts/boundaries.ts",
    "bindings:check": "bun scripts/bindings-check.ts",
    "bundle:check": "bun scripts/bundle-check.ts",
    "licences": "bun scripts/licences.ts",
    "auth:schema": "bun scripts/auth-schema.ts",
    "auth:check": "bun scripts/auth-schema.ts --check"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@effect/sql-pg": "catalog:",
    "@effect/tsgo": "0.46.1",
    "@insyte/database": "workspace:*",
    "@insyte/modules": "workspace:*",
    "@playwright/test": "1.58.2",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.6",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "dprint": "0.57.4",
    "effect": "catalog:",
    "knip": "6.38.0",
    "lefthook": "2.1.14",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "secretlint": "13.0.6",
    "syncpack": "15.3.3",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  }
}
