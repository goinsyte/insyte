# Staging's deploy credentials, for `bun --env-file ~/vantion/insyte/.env.staging run deploy:staging` when GitHub Actions
# cannot run. Copy to ~/vantion/insyte/.env.staging (outside the repo) and fill in; never commit the filled file.
# What staging is configured with is committed (infra/stages.ts).
CLOUDFLARE_API_TOKEN=
NEON_API_KEY=
INSYTE_APP_DB_PASSWORD=
DATABASE_URL_OWNER=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Optional: the API Worker's secrets (WORKER_SECRETS in infra/stages.ts). Any set here are sent to insyte-api-staging;
# the ones left out stay as they are on the Worker.
BETTER_AUTH_SECRET=
SEAL_KEYS=
GOOGLE_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
KLAVIYO_CLIENT_ID=
KLAVIYO_CLIENT_SECRET=
RESEND_API_KEY=
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=
SENDCLOUD_PUBLIC_KEY=
SENDCLOUD_SECRET_KEY=
