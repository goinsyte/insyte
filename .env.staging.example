# Staging's secrets, for `bun --env-file ~/vantion/insyte/.env.staging scripts/deploy-staging.ts` when GitHub Actions
# cannot run. Copy to ~/vantion/insyte/.env.staging (outside the repo) and fill in; never commit the filled file.
# The staging environment's variables (account id, Neon project, database host, …) are read from GitHub by the script.
CLOUDFLARE_API_TOKEN=
NEON_API_KEY=
INSYTE_APP_DB_PASSWORD=
BETTER_AUTH_SECRET=
DATABASE_URL_OWNER=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SEAL_KEYS=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
