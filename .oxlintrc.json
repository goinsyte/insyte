{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "import",
    "typescript",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "es2024": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.output/**",
    "**/coverage/**",
    "vendor/**",
    // The vendored Effect source (git subtree at the pinned tag, 04 header): upstream's code and upstream's rules.
    "repos/**",
    /*
     * Agent skill packages, installed into the working tree and not part of this repo — they are untracked, so
     * they never reach CI and only ever broke `preflight` locally. Same reasoning as the vendored Effect source
     * below: upstream's code, upstream's lint rules, and advice we cannot act on.
     */
    ".agents/**",
    ".claude/skills/**",
    // Impeccable's install for the other harnesses (Copilot, Codex) and its Claude Code agent definitions.
    ".claude/agents/**",
    // Agent worktrees (`git worktree`, created by Claude Code agents): another checkout of this repo, not code to lint.
    ".claude/worktrees/**",
    ".github/skills/**",
    ".github/agents/**",
    ".github/hooks/**",
    ".codex/**",
    ".wrangler/**",
    "**/worker-configuration.d.ts",
    "**/routeTree.gen.ts",
    /*
     * Ported code: the dashboard and legacy's component library, byte-identical to the legacy repo.
     * (The brand book left this list on 1 November 2026, when it was rebuilt; ADR-0026's addendum.)
     * Since ADR-0026 the dashboard lives in
     * `packages/ui/src/app/`, its route statements and fixtures in `apps/design/src/app/`.
     *
     * Not linted, for the same reason the vendored sources above are not: upstream's code, upstream's
     * rules, and advice nobody here can act on — every fix would be an edit to a port. The one thing
     * it would have caught in this repo is style (shadowed names, `sort` vs `toSorted`), which is not
     * what these files are held to. `packages/ui/src/app/lib/{env,auth-client,api}.ts` are written here
     * and sit under one of these paths because the ported code imports them by it; they are linted
     * through the exception below.
     */
    "packages/ui/src/components/**",
    "packages/ui/src/app/**",
    "packages/ui/src/data-source/types.ts",
    "apps/design/src/app/routes/_admin/**",
    "apps/design/src/app/routes/_aff/**",
    "apps/design/src/app/routes/_supplier/**",
    "apps/design/src/app/routes/onboarding/**",
    "apps/design/src/app/routes/invitations.$invitationId.tsx",
    "apps/design/src/app/routes/register.tsx",
    "apps/design/src/app/fixtures/mock-data/**",
    "apps/design/src/app/fixtures/scenario.ts",
    "apps/design/src/app/fixtures/affiliate-data.ts",
    "!packages/ui/src/app/lib/env.ts",
    "!packages/ui/src/app/lib/auth-client.ts",
    "!packages/ui/src/app/lib/api.ts",
    // Graduated (08 §3): the order, product and customer screens, wired to their commands in M7.
    "!packages/ui/src/app/orders/**",
    "!packages/ui/src/app/products/**",
    "!packages/ui/src/app/customers/**",
    // Graduated (08 §3): the suppliers screen, wired to its commands in M8.
    "!packages/ui/src/app/suppliers/**",
    // Graduated (08 §3): returns, the returns portal and quality, wired in M9.
    "!packages/ui/src/app/returns/**",
    "!packages/ui/src/app/quality/**",
    "!packages/ui/src/app/lib/returns.ts",
    "!packages/ui/src/app/lib/quality.ts",
    // Graduated (08 §3): Start's screens and the home store, wired to Home.* and the queue in M10. The queue panel
    // follows once the proposals branches (12.2) land, since they edit it.
    "!packages/ui/src/app/dashboard/**",
    "packages/ui/src/app/dashboard/queue-panel.tsx",
    "!packages/ui/src/app/stores/home-store.ts",
    // Graduated (08 §3): Instellingen → Meldingen, wired to Notifications.* in M11 (step 13.5).
    "!packages/ui/src/app/settings/notifications-screen.tsx",
    "!packages/ui/src/app/settings/notifications-source.tsx",
    "!packages/ui/src/app/settings/notifications-demo-source.tsx",
    // Graduated (08 §3): the day's kinds and the demo's day, split for Mijn werk, Agenda and Activiteit (12.3b).
    "!packages/ui/src/app/lib/home/day.ts",
    "!packages/ui/src/app/lib/home/kinds.ts",
    // Graduated (08 §3): Chats, wired to Chats.* in M11 (step 13.4b).
    "!packages/ui/src/app/chats/**",
    // Graduated (08 §3): the Inbox, wired to Threads.* and Mailboxes.* in M11 (step 13.2b).
    "!packages/ui/src/app/inbox/**",
    // Graduated (08 §3): Kosten, wired to Costs.* in M13 (step 15.5).
    "!packages/ui/src/app/costs/**",
    // Graduated (08 §3): wired to the API, so held to this repo's rules.
    "!packages/ui/src/app/auth/login-screen.tsx",
    "!packages/ui/src/app/onboarding/shared-steps.tsx",
    "!packages/ui/src/app/onboarding/admin-steps.tsx",
    "!packages/ui/src/app/lib/form-errors.ts",
    // Graduated (08 §3): Account and Regio, wired to Workspaces.* in M3.1, with the settings form kit.
    "!packages/ui/src/app/settings/form.tsx",
    "!packages/ui/src/app/settings/profile-screen.tsx",
    "!packages/ui/src/app/settings/regional-screen.tsx",
    // Graduated (08 §3): Beveiliging, wired to Session.* and Workspaces.getSecurity in M3.3.
    "!packages/ui/src/app/settings/security-screen.tsx",
    "!packages/ui/src/app/settings/security-source.tsx",
    "!packages/ui/src/app/settings/security-demo-source.tsx"
  ],
  "rules": {
    "no-console": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/consistent-type-imports": "error",
    "no-await-in-loop": "off",
    "no-underscore-dangle": "off"
  },
  "overrides": [
    {
      // A stylesheet is imported for its effect; there is nothing to assign. Scoped to the files
      // that own a document's entry rather than allowed everywhere — the reference has one per
      // section, because its sections cannot share a stylesheet (ADR-0026).
      "files": [
        "apps/*/src/main.tsx",
        "apps/design/src/*/main.tsx",
        "apps/design/src/app/boot.tsx",
        "apps/design/src/brand/tokens.tsx"
      ],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": [
        "scripts/**/*.ts",
        // Package build scripts: a generator that says what it wrote is doing its job.
        "packages/*/build.ts"
      ],
      "rules": {
        "no-console": "off",
        "unicorn/no-array-sort": "off"
      }
    }
  ]
}
