node_modules/
dist/
build/
.output/
.tanstack/
coverage/
*.tsbuildinfo

.wrangler/
.alchemy/
worker-configuration.d.ts

.env
.env.*
!.env.example

.DS_Store
.direnv/

# Generated by @tanstack/router-plugin from each app's routes directory — `apps/design` has two,
# `src/app/routeTree.gen.ts` and `src/brand/routeTree.gen.ts` (ADR-0026).
apps/*/src/routeTree.gen.ts
apps/*/src/*/routeTree.gen.ts

# Wrangler's local-secrets convention. Not currently used, ignored so it cannot become a
# committed credential the first time somebody follows the Cloudflare docs.
.dev.vars
.dev.vars.*

# Per-project incremental state, one dir per package now that src and test are separate projects.
.tsbuildinfo/

# Impeccable is used from the USER-level install (`impeccable install --global`), not vendored here.
#
# `impeccable install --project` fans the skill out into every harness it detects — nine directories
# and 171 MB on this machine — for a repo that only uses one. The design context it writes
# (`.impeccable/`, PRODUCT.md, DESIGN.md) IS ours and is committed; the skill itself is a tool
# install, so a stray project install stays out of the tree rather than becoming vendored content.
.claude/skills/
.claude/agents/
.cursor/
.agents/
.agent/
.gemini/
.kiro/
.opencode/
.pi/
.qoder/
.vibe/
.codex/
**/skills/impeccable/scripts/bin/

# Agent worktrees: separate checkouts of this repo (git worktree), never content of it.
.claude/worktrees/

# Impeccable's working screenshots and detector cache: regenerated on every review, ~140 MB.
# `design.json` and the direction mocks stay tracked; they are decisions, not output.
**/.impeccable/review/
**/.impeccable/hook.cache.json

# Playwright
playwright-report/
test-results/
playwright-report-console/

# The Shopify app's configuration as deployed (it names the app's client id) and the CLI's local cache. The committed
# template is `shopify/shopify.app.toml.example`.
shopify/shopify.app.toml
shopify/.shopify/
