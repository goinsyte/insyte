{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  /*
   * The API Worker for local development and the worker tests. No `env` blocks: preview, staging and production are
   * declared once in infra (alchemy stages, M0.6), not as copies of this file.
   */
  "name": "insyte-api",
  "main": "src/Main.ts",
  "compatibility_date": "2026-10-26",
  // `enable_request_signal`: a client that goes away aborts `request.signal`, and `toWebHandler` interrupts the fiber.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  /*
   * Logs, traces and Issues, each named: `enabled` alone turns on logs only. Sampled at 100 % through the MVP
   * (17 §1). The Sentry destinations are added per account in infra (17 §7).
   */
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    "issues": { "enabled": true },
  },
  // Next to Neon (aws-eu-central-1): a request is several sequential queries, the response is small.
  "placement": { "region": "aws:eu-central-1" },
  "dev": { "port": 8787 },
  /*
   * Postgres, as insyte_app. `localConnectionString` is the compose database (`bun run db:up`), used by `wrangler dev`
   * and the worker tests; each deployed environment gets its own Hyperdrive config from infra (M0.6), caching off.
   */
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://insyte_app:insyte_app_local@localhost:55443/insyte",
    },
  ],
  // 02 §5.1, local column. Read through `platform/Bindings.ts` only.
  // The edge guards' counters (M2.3): one instance per IP or hashed address, SQLite-backed.
  "durable_objects": { "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  "vars": {
    "ENVIRONMENT": "local",
    "CONSOLE_ORIGIN": "http://localhost:4300",
    "LOG_LEVEL": "Debug",
    "OTEL_SERVICE_NAME": "insyte-api",
    // Cloudflare's always-passes test key; each environment has its own widget.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },
}
