{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  /*
   * The API Worker for local development and the worker tests. No `env` blocks: preview, staging and production are
   * declared once in infra (alchemy stages, M0.6), not as copies of this file.
   */
  "name": "insyte-api",
  "main": "src/Main.ts",
  "compatibility_date": "2026-10-26",
  // `enable_request_signal`: a client that goes away aborts `request.signal`, and `toWebHandler` interrupts the fiber.
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  /*
   * Logs, traces and Issues, each named: `enabled` alone turns on logs only. Sampled at 100 % through the MVP
   * (17 §1). The Sentry destinations are added per account in infra (17 §7).
   */
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    "issues": { "enabled": true },
  },
  // Next to Neon (aws-eu-central-1): a request is several sequential queries, the response is small.
  "placement": { "region": "aws:eu-central-1" },
  "dev": { "port": 8787 },
  /*
   * Postgres, as insyte_app. `localConnectionString` is the compose database (`bun run db:up`), used by `wrangler dev`
   * and the worker tests; each deployed environment gets its own Hyperdrive config from infra (M0.6), caching off.
   */
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://insyte_app:insyte_app_local@localhost:55443/insyte",
    },
  ],
  // 02 §5.1, local column. Read through `platform/Bindings.ts` only.
  // The edge guards' counters (M2.3): one instance per IP or hashed address, SQLite-backed.
  // The realtime rooms (M5.1): one per audience, sockets only (hibernation API).
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "ROOMS", "class_name": "RoomDurableObject" },
      // The gate per external account (M6.3): token refresh single-flight, the vendor's bucket.
      { "name": "CONNECTION_GATE", "class_name": "ConnectionGateObject" },
    ],
  },
  // A store's first import (M6.3): durable steps, resumed where they stopped.
  "workflows": [
    { "binding": "SHOPIFY_BACKFILL", "name": "insyte-shopify-backfill", "class_name": "ShopifyBackfillWorkflow" },
    // A store's first analysis (M6.5): its early read, step by step.
    { "binding": "FIRST_ANALYSIS", "name": "insyte-first-analysis", "class_name": "FirstAnalysisWorkflow" },
    // An order change to Shopify (M7.1): a step per order, after the undo window.
    { "binding": "SHOPIFY_WRITE", "name": "insyte-shopify-write", "class_name": "ShopifyWriteWorkflow" },
    // A marketing sync's send to Klaviyo (M7.5), after the undo window.
    { "binding": "MARKETING_SYNC", "name": "insyte-marketing-sync", "class_name": "MarketingSyncWorkflow" },
    // A forward's delivery to its suppliers (M8.2), after the undo window.
    { "binding": "FORWARD_SEND", "name": "insyte-forward-send", "class_name": "ForwardSendWorkflow" },
    // A return's label from the carrier (M9.2), after the undo window.
    { "binding": "RETURN_LABEL", "name": "insyte-return-label", "class_name": "ReturnLabelWorkflow" },
    // A webhook delivery's attempts (M19.4): one per delivery, sleeping out the retry schedule.
    { "binding": "WEBHOOK_DELIVERY", "name": "insyte-webhook-delivery", "class_name": "WebhookDeliveryWorkflow" },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomDurableObject"] },
    { "tag": "v3", "new_sqlite_classes": ["ConnectionGateObject"] },
  ],
  // Files (M8.5): packing slips now, uploads later. Browser Rendering makes the slips' PDFs (not in the worker tests,
  // which store the HTML: `DOCUMENTS_ADAPTER=html`).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "insyte-files" }],
  "browser": { "binding": "BROWSER" },
  // The outbox relay (M1.4): committed events' ids onto EVENTS, consumed by this Worker; the minute cron sweeps.
  "queues": {
    "producers": [
      { "binding": "EVENTS", "queue": "insyte-events" },
      // Shopify's webhooks (M6.3): received deliveries, applied after the 200.
      { "binding": "INGEST", "queue": "insyte-ingest" },
    ],
    "consumers": [
      {
        "queue": "insyte-events",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "dead_letter_queue": "insyte-events-dlq",
      },
      {
        "queue": "insyte-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 8,
        "dead_letter_queue": "insyte-ingest-dlq",
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ENVIRONMENT": "local",
    "CONSOLE_ORIGIN": "http://localhost:4300",
    // The public API's own host (M19.2): a name no local request carries, so the tests can reach it on purpose.
    "PUBLIC_API_HOST": "api.public.test",
    "LOG_LEVEL": "Debug",
    "OTEL_SERVICE_NAME": "insyte-api",
    // Cloudflare's always-passes test key; each environment has its own widget.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    // The beta gate is shut locally too; the reserved test domain is admitted, so the tests can register.
    "BETA_ALLOWED_DOMAINS": "example.com",
  },
}
