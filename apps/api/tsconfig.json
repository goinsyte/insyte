{
  /*
   * One project for the Worker and its tests, the shape an app takes here (`apps/marketing`). Not composite:
   * wrangler bundles from source and nothing imports this app.
   */
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts", "vitest.configured.config.ts"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "tsBuildInfoFile": ".tsbuildinfo/api.tsbuildinfo",
    "lib": ["ES2023"],
    // The Worker's globals and `cloudflare:*` modules; `cloudflare:test` for the tests.
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"]
  }
}
