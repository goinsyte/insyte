{
  // The slices: one directory per slice, `shared/` for what every slice uses (16). Platform-free: `types: []`, so a
  // file that wants a Worker or Node global is in the wrong package.
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "types": []
  }
}
