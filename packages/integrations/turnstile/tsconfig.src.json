{
  // Cloudflare Turnstile's server-side check, for the API Worker. `fetch` and `FormData` only, which Workers and Node
  // both provide.
  "extends": "../../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": []
  }
}
