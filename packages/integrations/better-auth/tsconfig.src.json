{
  // better-auth over `pg`, for the API Worker and the schema script. Needs Web Crypto (`crypto.getRandomValues`), which
  // Workers and Node both provide.
  "extends": "../../../tsconfig.base.json",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": []
  }
}
